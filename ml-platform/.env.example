# Copy this file to .env and replace every CHANGE_ME or host-specific value.
# Do not commit .env or the LakeFS credentials file downloaded after first login.

# PostgreSQL
POSTGRES_USER=ml_platform
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_URL=postgresql://ml_platform:CHANGE_ME@postgres:5432

# SeaweedFS / S3
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
MLFLOW_S3_ENDPOINT_URL=http://seaweed:8333

# LakeFS, update with lakectl.yaml contents during initial setup
LAKEFS_AUTH_ENCRYPT_SECRET_KEY=CHANGE_ME
CREDENTIALS_ACCESS_KEY_ID=CHANGE_ME
CREDENTIALS_SECRET_ACCESS_KEY=CHANGE_ME
SERVER_ENDPOINT_URL=http://lakefs:8000

# Platform service endpoints, resolved on the Compose network
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ENABLE_SYSTEM_METRICS_LOGGING=true
INFERENCE_SERVER_URL=http://inference-server:8012
INFERENCE_CLIENT_URL=http://inference-client:8013
EVIDENTLY_ENDPOINT_URL=http://evidently:8002

# Host-specific paths. ML_PLATFORM_DATA_DIR is the checkout root that contains
# both ml-platform/ and configs/. XDG_RUNTIME_DIR is commonly /run/user/<uid>.
ML_PLATFORM_DATA_DIR=CHANGE_ME
XDG_RUNTIME_DIR=CHANGE_ME

# Podman and dynamically created workers
CONTAINER_HOST=unix:///run/podman/podman.sock
WORKER_GPU_ENABLED=false
WORKER_NETWORK=ml-platform_default

# Dependency readiness
SERVICE_READINESS_TIMEOUT_SECONDS=30
SERVICE_READINESS_POLL_INTERVAL_SECONDS=1

# Runtime and test controls
MLFLOW_DEFAULT_PREDICTION_DEVICE=cpu
RUN_LIVE_E2E=0
