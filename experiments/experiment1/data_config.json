{
    "data_configuration": {

        "phases": ["raw", "filter", "experiment"],
        
        "repository": "masters-thesis",

        "phase_configs": {
            "raw": {
                "data_branch": "main/",
                "pipeline": [
                    "data_processing.ensure_data_file",
                    "data_processing.LSWMD_to_df",
                    "data_processing.LSWMD_prepare",
                    "data_processing.df_to_lakeFS_parquet"
                ],
                "initial_arg": null,
                "pipeline_kwargs": {
                    "data_processing.ensure_data_file": {},
                    "data_processing.LSWMD_to_df": {},
                    "data_processing.LSWMD_prepare": {},
                    "data_processing.df_to_lakeFS_parquet": {"location": "masters-thesis/main/rawdata/", "ser_col": ["waferMap"]}
                },
                "final_arg": "masters-thesis/main/rawdata/"
            },

            "filter": {
                "data_branch":"filtered%/",
                "pipeline": [
                    "data_processing.lakeFS_parquet_to_df",
                    "image_processing.filter_by_grid_size",
                    "image_processing.LSWMD_pad",
                    "image_processing.LSWMD_scale",
                    "data_processing.df_to_lakeFS_parquet"
                ],
                "initial_arg": "masters-thesis/main/rawdata/",
                "pipeline_kwargs": {
                    "data_processing.lakeFS_parquet_to_df": {"deser_col": ["waferMap"]},
                    "image_processing.filter_by_grid_size": { "grid_col": "waferMap", "h_max": 150, "w_max": 150, "h_min": 75, "w_min": 75 },
                    "image_processing.LSWMD_pad": { "h":1, "w":1 },
                    "image_processing.LSWMD_scale": {"target_size": [128, 128]},
                    "data_processing.df_to_lakeFS_parquet": {"location": "masters-thesis/filtered%/filterdata/", "ser_col": ["waferMap"]}
                },
                "final_arg": "masters-thesis/filtered%/filterdata/"
            },

            "experiment": {
                "data_branch": "exp%/",
                "pipeline": [
                    "data_processing.lakeFS_parquet_to_df",
                    "data_processing.LSWMD_experiment_datasets_to_lakeFS",
                    "data_processing.metadata_to_lakeFS"
                ],
                "initial_arg": "masters-thesis/filtered%/filterdata/",
                "metadata_select": ["pipeline", "pipeline_kwargs.data_processing.LSWMD_experiment_datasets_to_lakeFS"],
                "pipeline_kwargs": {
                    "data_processing.lakeFS_parquet_to_df": {"deser_col": ["waferMap"]},
                    "data_processing.LSWMD_experiment_datasets_to_lakeFS": {
                        "N" : 50,
                        "seeds": [0, 10],
                        "l1": 3000,
                        "l2": 3000,
                        "class_ratio": 0.5,
                        "location": "masters-thesis/exp%/expdata/",
                        "scratch_kwargs": {
                            "n_scratches_range": [3,5],
                            "length_range": [0.3, 0.6],
                            "width_range": [0.01, 0.02],
                            "curvature_range": 0.0,
                            "angle_range": [0, 6.2832],
                            "circularity_range": [0.0, 1.0],
                            "degree": 4
                        },
                        "mapping_kwargs": {
                            "target_column": "failure_label",
                            "mapping": {"Scratch": 1},
                            "default_value": 0
                        }
                    },
                    "data_processing.metadata_to_lakeFS": {"metadata": {}}
                },
                "final_arg": "masters-thesis/exp%/expdata/"
            }
        }
    }
}
