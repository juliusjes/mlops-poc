{
  "training_config": {
        "dataset_location": "placeholder",
        "n_training_samples" : 3500,
        "model_source_type": "python",
        "model_load_kwargs": {
                "model_name": "simple_resnet"
            },

        "loop_name": "pytorch_classification_loop",
        "loop_kwargs": {},


        "train_loader_kwargs": {"batch_size": 64},
        "test_loader_kwargs": {"batch_size": 64},
        "optimizer": "Adam",
        "loss_function": "CrossEntropyLoss",
        "epochs": 30,
        "device": "cuda",
        "register_device": "cpu",
        
        "run_name": "Training_run",
        "model_register_name": "simple_resnet_exp2",

        "dataset_implementation": "lakefs_source",
        "dataset_description": {
            "sample_column": ["waferMap", "bytes"],
            "sample_shape": [1, 128, 128],
            "target_column": ["failure_label", "int"],
            "target_shape": [1],
            "order_column": ["write_timestamp", "datetime"],
            "target_interp": "classification"
        }
        
    },
  "validation_config": {
    "model_source": "mlflow",
    "model_load_kwargs": {
        "model_uri": "models:/simple_resnet_exp2/placeholder"
    },
    "dataset_implementation": "lakefs_source",
    "dataset_description": {
        "sample_column": ["waferMap", "bytes"],
        "target_column": ["failure_label", "int"],
        "order_column": ["write_timestamp", "datetime"],
        "target_interp": "classification",
        "sample_shape": [1, 128, 128],
        "target_shape": [1]
        },
    "validations": [
            {
                "validation_type": "standalone",
                "rules": [
                    {
                        "rule_name": "accuracy_W200",
                        "data_source": "placeholder",
                        "n_samples" : 750,
                        "metric": "accuracy_score",
                        "max_value": 1.0,
                        "min_value": 0.0
                    },
                    {
                        "rule_name": "recall_W200",
                        "data_source": "placeholder",
                        "n_samples" : 750,
                        "metric": "recall_score",
                        "max_value": 1.0,
                        "min_value": 0.0
                    },
                    {
                        "rule_name": "f1_W200",
                        "data_source": "placeholder",
                        "n_samples" : 750,
                        "metric": "f1_score",
                        "max_value": 1.0,
                        "min_value": 0.0
                    }
                ]
            }
        ]
    }
}